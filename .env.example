# ---------------------------------------------------------------------------
# Muchhad — The Urban Dhaba · environment template
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/muchhad?schema=public"

# Session signing secret for the admin panel.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# Public site URL — used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Restaurant timezone (IANA name) used for opening-hours calculations.
RESTAURANT_TIMEZONE="Asia/Kolkata"

# --- Seed data (only read by `npm run db:seed`) ----------------------------
SEED_ADMIN_EMAIL="admin@muchhad.test"
SEED_ADMIN_PASSWORD=""
# Demo integration values — replace with the real ones, or edit them later in
# Admin → Integrations. These are seeds only; the app always reads the database.
SEED_WHATSAPP_NUMBER="7600334353"
SEED_ZOMATO_URL=""
SEED_SWIGGY_URL=""
SEED_MAPS_URL=""
SEED_INSTAGRAM_URL=""

# --- Ordering integrations -------------------------------------------------
# WhatsApp, Zomato, Swiggy and Google Maps links are configured in the admin
# panel (Admin → Integrations), not here — these are only fallbacks used when
# seeding a brand-new database.
WHATSAPP_NUMBER=""
ZOMATO_URL=""
SWIGGY_URL=""
GOOGLE_MAPS_URL=""

# --- Payments (server-side only — never expose these to the browser) -------
# Razorpay is wired as the default Indian gateway. Until keys are present the
# app keeps online payment disabled and orders stay "payment pending".
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Email notifications (Resend-compatible) -------------------------------
EMAIL_API_KEY=""
EMAIL_FROM="orders@yourdomain.com"

# --- Image storage ---------------------------------------------------------
# "local" writes to /public/uploads (default, good for a single server).
# Switch to "s3" or "cloudinary" and fill in the credentials for object storage.
IMAGE_STORAGE_DRIVER="local"
IMAGE_STORAGE_KEY=""
IMAGE_STORAGE_SECRET=""
IMAGE_STORAGE_BUCKET=""
IMAGE_STORAGE_REGION=""
IMAGE_STORAGE_PUBLIC_URL=""
